#include "cybsp.h"
#include "retarget_io_init.h"

/* 1 秒旗標 */
volatile bool timer_flag = false;

/* 毫秒計數器 */
volatile uint32_t ms_count = 0;

/* 秒數計數器 */
uint32_t count = 0;

/*
 * SysTick 中斷函式
 * 每 1 ms 會進入一次
 */
void SysTick_Handler(void)
{
    /* 毫秒計數加 1 */
    ms_count++;

    /* 累積 1000 ms = 1 秒 */
    if (ms_count >= 1000)
    {
        /* 清除毫秒計數 */
        ms_count = 0;

        /* 設定 1 秒旗標，通知主迴圈 */
        timer_flag = true;
    }
}

int main(void)
{
    cy_rslt_t result;

    /* 初始化開發板 */
    result = cybsp_init();

    /* 若初始化失敗，進入錯誤處理 */
    if (result != CY_RSLT_SUCCESS)
    {
        handle_app_error();
    }

    /* 初始化 UART printf */
    init_retarget_io();

    /* 清除終端機畫面 */
    printf("\x1b[2J\x1b[;H");

    /* 顯示啟動訊息 */
    printf("PSoC Edge E84 SysTick Timer Demo\r\n\r\n");

    /*
     * 設定 SysTick 每 1 ms 觸發一次
     *
     * SystemCoreClock 代表 CPU 時脈頻率
     * SystemCoreClock / 1000U 代表 1 ms
     */
    if (SysTick_Config(SystemCoreClock / 1000U) != 0)
    {
        handle_app_error();
    }

    /* 啟用全域中斷 */
    __enable_irq();

    /* 主迴圈 */
    for (;;)
    {
        if (timer_flag)
        {
            /* 清除 1 秒旗標 */
            timer_flag = false;

            /* LED 反轉 */
            Cy_GPIO_Inv(CYBSP_USER_LED1_PORT,
                        CYBSP_USER_LED1_PIN);

            /* 印出計數 */
            printf("Timer Count = %lu\r\n", count);

            /* 秒數計數加 1 */
            count++;
        }
    }
}
